-- A view entity with an association to a persistent entity.
--
-- Selecting a persistent entity's id under an alias IS the declaration: the
-- alias becomes the association's name, and the id column is not one of the
-- view entity's attributes. There is no second statement for it.
--
-- Needs mxcli with ako/mxcli#452 ("View entities and widget bodies"). Before
-- that fix, check mis-aligned the columns, exec wrote no association, and the
-- build refused the model - see FINDINGS 1, which this script is the repro for.
--
-- The alias may not collide with an entity name in the module, case-insensitively:
-- `as meter` next to Trends.Meter is "Duplicate name 'Meter' in module 'Trends'".

@position(600, 700)
create or modify view entity Trends.MeterMonthRefVE (
  PeriodYear: Integer,
  MonthNo: Integer,
  TotalKwh: Decimal
) as (
  select m.ID                      as MeterRef
  ,      datepart(YEAR, r.ReadAt)  as PeriodYear
  ,      datepart(MONTH, r.ReadAt) as MonthNo
  ,      sum(r.Kwh)                as TotalKwh
  from   Trends.Reading as r
    inner join r/Trends.Reading_Meter/Trends.Meter as m
  group by m.ID, datepart(YEAR, r.ReadAt), datepart(MONTH, r.ReadAt)
);

-- Two of this grid's columns are read over the association, which is what
-- makes the second retrieve visible in the log.
create or replace page Trends.MeterRefGrid
(
  Title: 'Monthly totals, with the meter behind them',
  Layout: Atlas_Core.Atlas_Default,
  Url: 'meter-ref'
)
{
  TITLE ttlRef (Content: 'Monthly totals, with the meter behind them')
  DYNAMICTEXT dtRefSub (Content: 'Meter and Region are read over the association, not stored on the view entity.')
  DATAGRID gridRef (DataSource: DATABASE Trends.MeterMonthRefVE, PageSize: 15)
  {
    COLUMN colRefCode (Attribute: MeterRef/MeterCode, Caption: 'Meter')
    COLUMN colRefRegion (Attribute: MeterRef/Region, Caption: 'Region')
    COLUMN colRefYear (Attribute: PeriodYear, Caption: 'Year', Alignment: right)
    COLUMN colRefMonth (Attribute: MonthNo, Caption: 'Month', Alignment: right)
    COLUMN colRefKwh (Attribute: TotalKwh, Caption: 'Total kWh', Alignment: right)
  }
}
;
