-- Film 3's view entity: the smallest useful one.
--
-- The question is "how much energy did each meter use, per month?". Nobody
-- stored that; it is computed from Trends.Reading (6570 rows) joined to
-- Trends.Meter (6 rows) whenever something asks.
--
-- Three clauses and nothing else: what to return, where to get it, what to
-- group by. Every column in the select list is either a grouping key or an
-- aggregate - that is the one rule GROUP BY enforces.

@position(100, 700)
create or modify view entity Trends.MeterMonthVE (
  MeterCode: String(20),
  Region: String(40),
  PeriodYear: Integer,
  MonthNo: Integer,
  TotalKwh: Decimal,
  ReadingCount: Integer
) as (
  select m.MeterCode                  as MeterCode
  ,      m.Region                     as Region
  ,      datepart(YEAR, r.ReadAt)     as PeriodYear
  ,      datepart(MONTH, r.ReadAt)    as MonthNo
  ,      sum(r.Kwh)                   as TotalKwh
  ,      count(r.ID)                  as ReadingCount
  from   Trends.Reading as r
    inner join r/Trends.Reading_Meter/Trends.Meter as m
  group by m.MeterCode, m.Region,
           datepart(YEAR, r.ReadAt), datepart(MONTH, r.ReadAt)
);

-- Published so the same view entity can be asked for a filtered slice from
-- outside the app, which is where a WHERE clause is easiest to show whole.
create or modify odata service Trends.BasicsApi (
  path: 'odata/basics/v1/',
  version: '1.0.0',
  ODataVersion: OData4,
  namespace: 'Basics',
  ServiceName: 'BasicsApi',
  Summary: 'Energy per meter per month'
)
authentication basic
{
  publish entity Trends.MeterMonthVE as 'MeterMonth' (
    ReadMode: source,
    InsertMode: not_supported,
    UpdateMode: not_supported,
    DeleteMode: not_supported
  )
  expose (
    MeterCode    as 'meterCode'    (key, Filterable, Sortable),
    PeriodYear   as 'periodYear'   (key, Filterable, Sortable),
    MonthNo      as 'monthNo'      (key, Filterable, Sortable),
    Region       as 'region'       (Filterable, Sortable),
    TotalKwh     as 'totalKwh'     (Filterable, Sortable),
    ReadingCount as 'readingCount' (Filterable, Sortable)
  );
};
